{
    "name": "dax-87/badwords-it",
    "description": "Italian profanity and spam filter for PHP. Three-level detection: regex, substring, compound phrases.",
    "type": "library",
    "license": "MIT",
    "keywords": ["profanity", "filter", "italian", "spam", "badwords", "content-moderation"],
    "homepage": "https://github.com/Dax-87/badwords-it",
    "authors": [
        {
            "name": "Dax-87",
            "homepage": "https://github.com/Dax-87"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "BadwordsIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BadwordsIt\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
